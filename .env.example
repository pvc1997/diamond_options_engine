# === Cache TTLs (seconds) ===
CACHE_CHAIN_TTL=300             # 5 minutes (options chains are fast-moving)
CACHE_PRICES_TTL=14400          # 4 hours
CACHE_IV_TTL=1800               # 30 minutes

# === Risk Management ===
INITIAL_CAPITAL=500000          # INR
MAX_RISK_PER_TRADE_PCT=2.0      # 2% of capital per trade
MAX_MARGIN_UTILIZATION=0.30     # 30% of capital
MAX_PORTFOLIO_DELTA=500         # Nifty-equivalent delta units
MAX_OPEN_POSITIONS=10           # Max simultaneous positions
STOP_LOSS_PCT=50.0              # % of max loss to trigger stop

# === Market Defaults ===
RISK_FREE_RATE=0.065            # 6.5% (India 10Y govt bond)
INDEX_TICKER=^NSEI              # Nifty 50
BANK_INDEX_TICKER=^NSEBANK      # Bank Nifty
DEFAULT_LOOKBACK_DAYS=252       # 1 year trading days

# === Execution ===
DRY_RUN=true                    # Paper trading by default
CIRCUIT_BREAKER_PCT=0.05        # 5% price deviation limit
MAX_TRADES_PER_SESSION=20

# === Kite Connect (Live Trading) ===
# KITE_API_KEY=your_key
# KITE_API_SECRET=your_secret
# KITE_DRY_RUN=true
